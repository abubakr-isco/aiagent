# Copy to .env and fill in. Never commit .env.

# --- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_HTTPS=false          # true behind HTTPS (cookies secure, HSTS, redirect)
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading
POSTGRES_PASSWORD=change-me
DATA_DIR=./data                    # CSV files for backtests live here
LOG_LEVEL=INFO

# --- first admin user (created by `manage.py bootstrap_roles`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- safety switches
ALLOW_LIVE_TRADING=false           # real-money trading is impossible while false
AGENT_AUTO_RESUME=false            # after a restart the agent stays PAUSED until someone presses Start

# --- MT5 terminal (only when the gateway is "mt5", i.e. Django runs on the Windows host)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                          # optional: C:\Program Files\MetaTrader 5\terminal64.exe

# --- remote bridge (gateway "remote")
MT5_BRIDGE_URL=https://your-windows-vps:8765
MT5_BRIDGE_TOKEN=                  # same value as BRIDGE_TOKEN on the Windows host, 32+ chars
MT5_BRIDGE_CA_FILE=                # optional CA/cert file for a self-signed bridge certificate

# --- on the Windows host only (bridge/mt5_bridge.py)
BRIDGE_TOKEN=
BRIDGE_ALLOW_REAL=false            # bridge refuses order_send on non-demo accounts while false
BRIDGE_ALLOWED_IPS=                # comma-separated client IPs, empty = any authenticated client
